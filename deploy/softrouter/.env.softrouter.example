# ============================================================================
# 软路由本地栈环境变量。复制为 .env 后修改：cp .env.softrouter.example .env
# 请勿把真实密码提交到仓库。
# ============================================================================

# ---- 持久化数据根目录（务必指向软路由外接磁盘/大分区，不要用内存/tmpfs）----
# PostgreSQL 数据存于 ${DATA_ROOT}/postgres，MinIO 数据存于 ${DATA_ROOT}/minio
DATA_ROOT=/mnt/sda1/score-player-data

# ---- 本地 PostgreSQL（主库）----
PG_USER=score
PG_PASSWORD=change-me-pg
PG_DB=scoredb
# 端口发布：默认仅监听宿主机回环，避免误暴露到公网
PG_PUBLISH=127.0.0.1:5432

# ---- 本地 MinIO（主对象存储）----
MINIO_ROOT_USER=scoreadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_REGION=us-east-1
B2_BUCKET=score-player
MINIO_S3_PUBLISH=127.0.0.1:9002
MINIO_CONSOLE_PUBLISH=127.0.0.1:9001

# ---- score-player 应用发布端口（保持与现网一致 9000）----
APP_PUBLISH=9000

# ---- 阿里云 ACR 登录配置 ----
# migrate.sh 会在 docker-compose up -d 前执行 docker login；sp-webhook 通过挂载
# /root/.docker 复用宿主机登录凭据，以便容器内 docker pull 私有/受限镜像。
ACR_REGISTRY=crpi-rd0vl6t3c1p11agm.cn-beijing.personal.cr.aliyuncs.com
ACR_USERNAME=change-me-acr-username
ACR_PASSWORD=change-me-acr-password

# ---- Webhook 自动部署 token ----
# 用于校验 GitHub Actions 经 Cloudflare Tunnel 打到 /deploy?token=... 的请求。
# 必须与 GitHub 仓库 Secret「WEBHOOK_TOKEN」的值完全一致，建议使用 32 位随机串，
# 生成方式示例：python3 -c "import secrets;print(secrets.token_hex(16))"
WEBHOOK_TOKEN=change-me-webhook-token

# ---- GitHub API 下载 token（可选）----
# migrate.sh 会用该 token 从 GitHub API 下载最新 docker-compose.yml 与 webhook/server.py。
# 公开仓库留空也可访问，但会受到 GitHub 未认证请求速率限制。
GITHUB_TOKEN=
