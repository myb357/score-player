# ============================================================================
# 同步容器环境变量。复制为 .env.sync 并填入真实值。请勿提交真实密钥。
# ============================================================================

# ---- 源：本地主库（容器内通过 compose 网络访问 db 服务）----
# 必须显式 sslmode=disable（本地库无 SSL）
LOCAL_DATABASE_URL=postgresql://score:change-me-pg@db:5432/scoredb?sslmode=disable

# ---- 目的：云端 Supabase（Session Pooler，含 sslmode=require）----
CLOUD_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# ---- 同步模式：full(镜像全量刷新，默认) | upsert(增量只增改)----
SYNC_MODE=full

# ---- 是否同步 sessions 表（登录会话，通常无需上云）1=同步 0=不同步 ----
SYNC_SESSIONS=0

# ---- 对象存储 bucket 名（minio 与 b2 同名）----
B2_BUCKET=score-player

# ---- rclone 操作：sync(镜像,会删云端多余对象,默认) | copy(只增改不删) ----
RCLONE_OP=sync
