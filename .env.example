# ============================================================================
# 环境变量示例。复制为 .env 并填入真实值；请勿把真实密钥提交到仓库。
# ============================================================================

# --- 运行时临时目录（仅存放 ffmpeg 转码临时文件） ---
SCORE_DATA_DIR=/tmp/score_app_data

# --- Supabase PostgreSQL 连接串 ---
# 线上建议使用 Session Pooler，例如：postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Backblaze B2（S3 兼容）对象存储 ---
B2_KEY_ID=<your-b2-key-id>
B2_APP_KEY=<your-b2-application-key>
B2_ENDPOINT=s3.ca-east-006.backblazeb2.com
B2_BUCKET=score-player
B2_REGION=ca-east-006
# 预签名 URL 有效期（秒），默认 7 天，S3 上限为 604800
# B2_PRESIGN_TTL=604800

# --- 媒体分发模式（本地/云端区分）---
# MEDIA_PROXY=0（默认，云端 Render）：/api/media 302 跳转到公网可达的预签名 URL（如 B2）。
# MEDIA_PROXY=1（软路由/本地 MinIO）：预签名 URL 指向内网地址(如 http://minio:9000)，
#   终端设备不可达，故由本服务直接回源转发字节流（支持 HTTP Range，音频可拖动）。
# MEDIA_PROXY=0

# ============================================================================
# 软路由本地部署（主库）示例：连本地 PostgreSQL + 本地 MinIO
#   注意：本地 PostgreSQL 无 SSL，DATABASE_URL 必须显式带 sslmode=disable，
#         否则 main.py 会自动追加 sslmode=require 导致连接失败。
# ----------------------------------------------------------------------------
# DATABASE_URL=postgresql://score:<pwd>@db:5432/scoredb?sslmode=disable
# B2_ENDPOINT=http://minio:9000
# B2_KEY_ID=<minio-access-key>
# B2_APP_KEY=<minio-secret-key>
# B2_BUCKET=score-player
# B2_REGION=us-east-1
# MEDIA_PROXY=1
# 详见 deploy/softrouter/README.md
# ============================================================================

# --- 管理员登录（可选，默认见 main.py） ---
# ADMIN_USERNAME=admin
# ADMIN_SALT=<hex-salt>
# ADMIN_HASH=<pbkdf2-sha256-hash>
