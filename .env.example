# ============================================================================
# 环境变量示例。复制为 .env 并填入真实值；请勿把真实密钥提交到仓库。
# ============================================================================

# --- 运行时临时目录（仅存放 ffmpeg 转码临时文件） ---
SCORE_DATA_DIR=/tmp/score_app_data

# --- Supabase PostgreSQL 连接串 ---
# 形如：postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# --- Backblaze B2（S3 兼容）对象存储 ---
B2_KEY_ID=<your-b2-key-id>
B2_APP_KEY=<your-b2-application-key>
B2_ENDPOINT=s3.ca-east-006.backblazeb2.com
B2_BUCKET=score-player
B2_REGION=ca-east-006
# 预签名 URL 有效期（秒），默认 7 天，S3 上限为 604800
# B2_PRESIGN_TTL=604800

# --- 管理员登录（可选，默认见 main.py） ---
# ADMIN_USERNAME=admin
# ADMIN_SALT=<hex-salt>
# ADMIN_HASH=<pbkdf2-sha256-hash>
